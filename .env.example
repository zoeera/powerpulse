# PowerPulse Environment Variables

# Database
POSTGRES_USER=powerpulse
POSTGRES_PASSWORD=powerpulse_secret
POSTGRES_DB=powerpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://powerpulse:powerpulse_secret@localhost:5432/powerpulse_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
